<div id="fitem_id_sender" class="mb-3 row  fitem ">
    <div class="col-md-3 col-form-label d-flex pb-0 pe-md-0">

        <label id="id_sender_label" class="d-inline word-break " for="id_sender">
            {{#str}} sender, paygw_transfer{{/str}}
        </label>

        <div class="form-label-addon d-flex align-items-center align-self-start">
            <div class="text-danger" title="{{#str}} required {{/str}}">
                <i class="icon fa fa-circle-exclamation text-danger fa-fw" {{!
                    }}title="{{#str}}required{{/str}}" role="img" {{!
                    }}aria-label="{{#str}}required{{/str}}"></i>
            </div>

        </div>
    </div>
    <div class="col-md-9 d-flex flex-wrap align-items-start felement" data-fieldtype="text">
        <input type="text" class="form-control " name="sender" id="id_sender" value="" aria-required="true">
        <div class="form-control-feedback invalid-feedback" id="id_error_sender">
        </div>
    </div>
</div>
